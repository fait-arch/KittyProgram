# Copia a .env.local y ajusta.

# Backend FastAPI. El proxy src/app/api/v1/[...path]/route.ts reenvía /api/v1/* a esta URL.
BACKEND_URL=http://localhost:8000

# Base de la API vista desde el navegador. Déjalo en /api/v1 para usar el proxy de Next.
# Si apuntas directo al backend (https://api.ejemplo.org/api/v1), activa CORS en FastAPI.
NEXT_PUBLIC_API_BASE=/api/v1

# Fuente de datos:
#   auto -> usa la API; si un endpoint falla, muestra datos de demostración (con aviso)
#   api  -> solo la API (los errores se muestran)
#   mock -> solo datos de demostración de public/mock (sin backend)
NEXT_PUBLIC_DATA_MODE=auto

# Solo para `npm run dev`: hosts extra desde los que otros pueden abrir la app (las IPs de esta
# máquina ya están permitidas). Separados por comas; admite comodines por segmento.
# Ejemplos: 192.168.1.*   ·   mi-pc.local   ·   *.trycloudflare.com
ALLOWED_DEV_ORIGINS=
