{
	"include": ["src/**/*.ts", "src/**/*.svelte", ".svelte-kit/types/**/$types.d.ts", ".svelte-kit/ambient.d.ts", "vite.config.ts"],
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "node"],
		"rootDirs": [".", ".svelte-kit/types"],
		"paths": { "#lib/*": ["./src/lib/*"] },
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noImplicitAny": false,
		"noEmit": true
	}
}
