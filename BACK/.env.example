# ── Google Earth Engine ──────────────────────────────────────
# Copia este archivo a .env y rellena los valores reales.
#   cp .env.example .env

# ID del proyecto de Google Cloud registrado en Earth Engine.
# OJO: es un ID tipo "mi-proyecto-123", NO una API key (AIzaSy...).
GEE_PROJECT=tu-project-id

# ── Autenticacion ────────────────────────────────────────────
# Local: basta con `earthengine authenticate`, deja lo de abajo comentado.
#
# Docker / produccion: crea un Service Account con rol
# "Earth Engine Resource Viewer", descarga su JSON y descomenta:
# GEE_SERVICE_ACCOUNT=gee-backend@tu-project-id.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_PATH=/app/gee-key.json
#
# Alternativa para entornos sin filesystem (ej. Cloud Run): pega el JSON entero
# GEE_PRIVATE_KEY_JSON={"type":"service_account", ...}

# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API. La service_role es SECRETA (solo backend).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Emails con permiso para editar el catálogo de cultivos (separados por coma)
ADMIN_EMAILS=

# ── NASA Earthdata (opcional, para ECOSTRESS) ────────────────
# https://urs.earthdata.nasa.gov → Generate Token (caduca a los 60 días)
EARTHDATA_TOKEN=
