# Copia este archivo a .env y rellena los valores reales:   cp .env.example .env
# .env está en .gitignore: NUNCA subir claves al repo.

# ══ API (backend integrador) ════════════════════════════════════
# mock = datos sintéticos (sin BD) · supabase = datos reales
DATA_SOURCE=mock

# ── Supabase ─────────────────────────────────────────────────
# Project Settings → API. La API solo LEE.
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (sb_publishable_…) o anon: recomendada para la API (respeta RLS)
SUPABASE_ANON_KEY=
# Secreta (sb_secret_…): salta RLS. Solo servidor, nunca al front ni al repo.
# Se usa solo si falta la publishable.
SUPABASE_SECRET_KEY=

# ── IA (insights y recomendaciones) ──────────────────────────
AI_PROVIDER=deepseek             # deepseek | anthropic
AI_MODEL=                        # vacío = deepseek-chat / claude-opus-5-5
DEEPSEEK_API_KEY=                # https://platform.deepseek.com → API keys
ANTHROPIC_API_KEY=               # solo si AI_PROVIDER=anthropic
AI_EFFORT=medium                 # solo anthropic

# ── Modelo ML (dentro del backend) ───────────────────────────
PREDICTOR_MODE=local             # local | off
MODEL_PATH=models/cacao_loss.joblib   # o ../ml/artifacts/cacao_loss_v1.joblib (rama de Arthur)
ML_INFERENCE_MODULE=ml.inference   # opcional: ml/inference.py de la raíz del repo

# ── Seguridad / operación ────────────────────────────────────
# Clave para /api/v1/admin/* (cabecera X-Admin-Key). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:3000
CACHE_TTL_SECONDS=3600

# ══ ETL / scripts de datos (la API no los usa) ══════════════════
# ID del proyecto de Google Cloud registrado en Earth Engine (no es una API key).
GEE_PROJECT=tu-project-id
# GEE_PRIVATE_KEY_PATH=gee-key.json
# NASA Earthdata (ECOSTRESS vía AppEEARS): https://urs.earthdata.nasa.gov → Generate Token
EARTHDATA_TOKEN=
