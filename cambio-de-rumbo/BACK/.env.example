# =====================================================================
#  CacaoResiliente — BACK/.env.example
#  Basado en docs/APIS-DATOS.md (16 fuentes).
#  Copia a .env:   cp .env.example .env
#  .env NUNCA se sube a GitHub. Este .example SÍ.
# =====================================================================

# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development                 # development | production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ── 1. Google Earth Engine (OBLIGATORIO) ─────────────────────────────
# Fuentes 3–8 y 15: ERA5-Land, GPM IMERG, SMAP L4, GLDAS, MODIS NDVI,
# SRTM, OpenLandMap, WorldCover, FAO GAUL y NEX-GDDP-CMIP6.
# ID del proyecto de Google Cloud registrado en Earth Engine
# (tipo "mi-proyecto-123"). NO es una API key (AIzaSy...).
GEE_PROJECT=tu-project-id

# Local: basta con `earthengine authenticate`. Deja esto comentado.
# Producción / Docker: Service Account con rol "Earth Engine Resource Viewer".
# GEE_SERVICE_ACCOUNT=gee-backend@tu-project-id.iam.gserviceaccount.com
# GEE_PRIVATE_KEY_PATH=/app/gee-key.json
# GEE_PRIVATE_KEY_JSON={"type":"service_account", ...}


# ── 2. Supabase (OBLIGATORIO) ────────────────────────────────────────
# Project Settings → API Keys (pestaña "Legacy API keys")
# URL SIN /rest/v1/ al final.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SECRETA: ETL, ML y caché. Solo backend.
ADMIN_EMAILS=                       # correos separados por coma


# ── 3. NASA Earthdata (Fase 3 · fuente 16: ECOSTRESS vía AppEEARS) ───
# https://urs.earthdata.nasa.gov
EARTHDATA_USER=
EARTHDATA_PASS=
EARTHDATA_TOKEN=                    # opcional; caduca a los 60 días


# ── 4. Fuentes SIN cuenta (ya traen valor por defecto en config.py) ──
# Solo descomenta si una URL cambia.
# NOAA_ONI_URL=https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt
# NOAA_SSTOI_URL=https://www.cpc.ncep.noaa.gov/data/indices/sstoi.indices
# ECOCROP_CSV_URL=https://raw.githubusercontent.com/OpenCLIM/ecocrop/main/EcoCrop_DB.csv
# FAOSTAT_BULK_URL=https://bulks-faostat.fao.org/production/Production_Crops_Livestock_E_Americas.zip
# NASA_POWER_URL=https://power.larc.nasa.gov/api/temporal
# GBIF_API_URL=https://api.gbif.org/v1
# APPEEARS_API_URL=https://appeears.earthdatacloud.nasa.gov/api


# ── 5. Parámetros del proyecto ───────────────────────────────────────
CROP_SCIENTIFIC_NAME=Theobroma cacao
FAOSTAT_ITEM=Cocoa beans
PROVINCES=Los Rios,Guayas,Manabi,Esmeraldas,El Oro
POWER_START_YEAR=2005
POWER_END_YEAR=2024


# ── 6. Caché local ───────────────────────────────────────────────────
CACHE_DIR=./cache
CACHE_TTL_HOURS=168                 # 7 días
HTTP_TIMEOUT_SECONDS=60
